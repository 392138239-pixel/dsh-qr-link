{
  "name": "dsh-qr-link",
  "version": "1.1.1",
  "description": "Decode QR codes from images, pasted screenshots and image URLs — with a measured diagnosis when nothing is found — and render any text or link back into a downloadable QR code.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qrcode",
    "qr",
    "barcode",
    "decode",
    "encode",
    "clipboard"
  ],
  "license": "MIT",
  "author": "bbwy <392138239-pixel@users.noreply.github.com>",
  "homepage": "https://github.com/392138239-pixel/dsh-qr-link#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/392138239-pixel/dsh-qr-link.git"
  },
  "bugs": {
    "url": "https://github.com/392138239-pixel/dsh-qr-link/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "assets/*.png",
    "LICENSE",
    "LICENSE-jsQR.txt",
    "LICENSE-qrcode-generator.txt",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
